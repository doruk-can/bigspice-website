---
import '../styles/fonts.css';
import '../styles/global.css';
import Sprites from '../components/Sprites.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site.mjs';
import { copy, counterpart, href, LOCALES, type Locale } from '../lib/copy';

interface Props { lang: Locale; title: string; description: string; jsonLd?: unknown; noindex?: boolean }
const { lang, title, description, jsonLd, noindex = false } = Astro.props;
const t = copy[lang];

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
/* the page, language-stripped, so every locale can be addressed from any page.
   counterpart() keeps the 404 from advertising a /tr/404 that does not exist. */
const rest = counterpart(lang === 'en' ? here : here.replace(/^\/tr/, '') || '/');
const canonical = new URL(here, SITE.url).href;
/* one card per language — the tagline on it is the page's own tagline */
const ogImage = new URL(lang === 'en' ? '/og.png' : `/og-${lang}.png`, SITE.url).href;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {/* Cloudflare serves 404.html with a 404 status, which is already enough to
      keep it out of the index. This is the belt to that pair of braces. */}
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="author" content={SITE.company} />

  <meta name="theme-color" content="#F6F1E7" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#1C1916" media="(prefers-color-scheme: dark)" />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap.xml" />

  {LOCALES.map((l) => (
    <link rel="alternate" hreflang={l} href={new URL(href(l, rest), SITE.url).href} />
  ))}
  <link rel="alternate" hreflang="x-default" href={new URL(href('en', rest), SITE.url).href} />

  <!-- the body face, same-origin, so it lands before first paint and nothing
       reflows when it swaps in -->
  <link rel="preload" href="/fonts/newsreader-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
  {/* ş and ğ live in the latin-ext subset, so half the site's pages were
      racing for 85 KB the preload had never been told about — which is why
      "Ne yapıyor" and "Şefe sor" were the only text that re-flowed after
      first paint. ı and İ are in the latin file already. */}
  {lang === 'tr' && (
    <link rel="preload" href="/fonts/newsreader-normal-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
  )}

  <meta property="og:type" content="website" />
  <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
  <meta property="og:locale:alternate" content={lang === 'tr' ? 'en_US' : 'tr_TR'} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={t.meta.ogAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <!-- without this the card is announced with no description of its picture -->
  <meta name="twitter:image:alt" content={t.meta.ogAlt} />

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <!-- Two jobs, one blocking script, because both have to happen before the
       first pixel.

       (1) The language. English is the default and `/` is x-default; a
       visitor whose device is set to Turkish is sent to /tr the first time
       they arrive at the home page, and never again after that — the moment
       anyone uses the globe in the header, their choice is remembered and
       this stops deciding for them. location.replace, so Back is not a trap.
       Deep pages are left alone: someone arriving at /privacy from the app is
       there for that document, not for a language.
       A crawler reports en-US, so it is served English, which is what the
       hreflang tags and x-default say it should be.

       (2) The `js` class. The choreography module is type="module" and runs
       AFTER first paint, so the stylesheet's `html:not(.js)` end states would
       render for a frame and then be undone — the pot visibly full of food,
       then empty. Deciding the class here is what stops that flash. It stays
       off under reduced motion, where the end states ARE the design. -->
  <script is:inline define:vars={{ auto: SITE.autoLanguage && lang === 'en' && here === '/' }}>
    try {
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('.lang-switch');
        if (a) localStorage.setItem('bs-lang', a.getAttribute('hreflang') || '');
      });
      if (auto && !localStorage.getItem('bs-lang')) {
        var list = navigator.languages && navigator.languages.length
          ? navigator.languages : [navigator.language || ''];
        if (String(list[0]).slice(0, 2).toLowerCase() === 'tr') location.replace('/tr');
      }
    } catch (err) { /* private mode, blocked storage: stay on English */ }
  </script>

  <!-- The one blocking script on the site, and it is 96 bytes. The
       choreography module is type="module", so it runs AFTER first paint: the
       stylesheet's `html:not(.js)` end states would render for a frame and
       then be undone — the pot visibly full of food, then empty. Deciding the
       class here, before anything paints, is what stops that flash. It stays
       off under reduced motion, where the end states ARE the design. -->
  <script is:inline>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
      document.documentElement.classList.add('js');
  </script>
</head>
<body>
  <a class="skip" href="#main">{t.a11y.skip}</a>
  <Sprites />
  <Nav lang={lang} />
  <main id="main" tabindex="-1"><slot /></main>
  <Footer lang={lang} />
</body>
</html>
