---
import Legal from '../layouts/Legal.astro';
import * as doc from '../../legal/terms-of-use.md';
import { fill, lastUpdatedISO } from '../lib/legal';
import { copy } from '../lib/copy';
import { legalSchema } from '../lib/schema';

/* The source is legal/terms-of-use.md at the project root, imported, never
   copied — one file, one truth. compiledContent() hands back the markdown
   already rendered, which is the only point at which the handoff's bracketed
   placeholders can be filled without touching the drafting itself.
   See src/lib/legal.ts and legal/README.md section 2. */
const lang = 'en' as const;
const t = copy[lang];
const html = fill(await doc.compiledContent());
const updated = lastUpdatedISO(doc.rawContent());
---
<Legal lang={lang} title={t.meta.termsTitle} description={t.meta.termsDescription}
       jsonLd={legalSchema(lang, '/terms', t.meta.termsTitle, t.meta.termsDescription, updated)}
       notice={lang !== 'en'}>
  <Fragment set:html={html} />
</Legal>
