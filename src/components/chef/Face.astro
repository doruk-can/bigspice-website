---
/**
 * LAYER — head, moustache, toque, smoked rounds. Drawn last so it sits over
 * the arms, the way he is composed everywhere else in the product.
 * HEAD CENTRE: (122, 152) in chef space, radius 56 × 52.
 *
 * `grin` is the delighted face for the moment dinner appears.
 * `brows: 'raised'` lifts them 6 units — the look that goes with the pointer.
 */
interface Props { mood?: 'calm' | 'grin'; brows?: 'level' | 'raised' }
const { mood = 'calm', brows = 'level' } = Astro.props;
---
<g class="p-head">
  {/* The wash is the SAME ellipse as the ink line below it. It used to be
      56x52 at (122,152) against a line of 54x50 at (120,151) — bigger AND
      offset — so up to 4 units of skin sat outside the contour on the right
      and 3 below it. On the largest shape in the drawing that does not read
      as watercolour, it reads as a plate that slipped in the press. Other
      parts keep their offset wash; they are small and it is even. */}
  <ellipse cx="120" cy="151" rx="54" ry="50" fill="var(--fg-skin)"/>
  <circle cx="86" cy="167" r="9" fill="var(--fg-cheek)"/>
  <circle cx="157" cy="165" r="9" fill="var(--fg-cheek)"/>
  <circle cx="121" cy="157" r="15" fill="var(--fg-nose)" transform="translate(-2 -1)"/>
  <ellipse cx="120" cy="151" rx="54" ry="50" fill="none" stroke="var(--fg-line)" stroke-width="2.8"/>

  <g class="p-eyes">
    {mood === 'grin' ? (
      <path d="M92 138 q7 -7 14 0 M136 136 q7 -7 14 0" fill="none" stroke="var(--fg-line)" stroke-width="3.2" stroke-linecap="round"/>
    ) : (
      <>
        <circle cx="99" cy="137" r="4.6" fill="var(--fg-line)"/>
        <circle cx="143" cy="135" r="4.6" fill="var(--fg-line)"/>
      </>
    )}
  </g>

  <g class="p-brows" transform={brows === 'raised' ? 'translate(0 -6)' : undefined}>
    <path d="M82 116 q16 -11 32 -5 M130 108 q16 -7 32 6" fill="none" stroke="var(--fg-line)" stroke-width="3.4" stroke-linecap="round"/>
  </g>
  <circle cx="120" cy="156" r="15" fill="none" stroke="var(--fg-line)" stroke-width="2.8"/>
  <path d="M104 170 q16 8 32 0" fill="none" stroke="var(--fg-brow)" stroke-width="5.5" stroke-linecap="round"/>
  <g class="p-tips">
    <path d="M104 170 Q88 168 82 156 Q80 150 85 148" fill="none" stroke="var(--fg-brow)" stroke-width="5.5" stroke-linecap="round"/>
    <path d="M136 170 Q152 166 158 154 Q160 148 155 146" fill="none" stroke="var(--fg-brow)" stroke-width="5.5" stroke-linecap="round"/>
  </g>

  <g class="p-mouth">
    {mood === 'grin' ? (
      <path d="M104 184 q16 16 32 0 q-16 6 -32 0 Z" fill="#C0492F" stroke="var(--fg-line)" stroke-width="2.6" stroke-linejoin="round"/>
    ) : (
      <path d="M108 186 q12 7 24 0" fill="none" stroke="var(--fg-line)" stroke-width="2.8" stroke-linecap="round"/>
    )}
  </g>

  <g class="p-hat"><use href="#tq"/></g>

  <g class="p-specs">
    <circle cx="106" cy="86" r="6.5" fill="var(--fg-brow)" fill-opacity=".9"/>
    <circle cx="134" cy="85" r="6.5" fill="var(--fg-brow)" fill-opacity=".9"/>
    <circle cx="106" cy="86" r="6.5" fill="none" stroke="var(--fg-line)" stroke-width="2"/>
    <circle cx="134" cy="85" r="6.5" fill="none" stroke="var(--fg-line)" stroke-width="2"/>
    <path d="M112 85 q8 -3 16 0" fill="none" stroke="var(--fg-line)" stroke-width="2"/>
  </g>
</g>
