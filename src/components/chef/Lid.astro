---
/**
 * LAYER — the lid. Drawn in the pot's own 0 0 160 132 space so it drops
 * straight onto the rim at y = 40.
 *
 * Swapping in painted art: replace this file's contents with
 * <image href="/chef/lid.png" x="18" y="2" width="124" height="42"/> — the
 * knob must sit on x = 80 and the lid's bottom edge on y = 40.
 */
---
<g class="lid-rig"><g class="lid-shake">
  <path d="M22 40 C26 16 134 16 138 40 Z" fill="var(--fg-steel)"/>
  <path d="M22 40 C26 16 134 16 138 40" fill="none" stroke="var(--prop-line)" stroke-width="2.8" stroke-linejoin="round"/>
  <path d="M16 40 L144 40" fill="none" stroke="var(--prop-line)" stroke-width="3.4" stroke-linecap="round"/>
  <path d="M80 18 v-5" fill="none" stroke="var(--prop-line)" stroke-width="3" stroke-linecap="round"/>
  <circle cx="80" cy="8" r="7" fill="var(--fg-pot)"/>
  <circle cx="80" cy="8" r="7" fill="none" stroke="var(--prop-line)" stroke-width="2.4"/>
  <path d="M44 31 q14 -7 28 -7" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" opacity=".42"/>
</g></g>
